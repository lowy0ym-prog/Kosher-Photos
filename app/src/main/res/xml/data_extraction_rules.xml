<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: keep the proxy access key out of backups and phone-to-phone copies. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="proxy_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="proxy_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
